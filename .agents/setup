#!/usr/bin/env bash
set -euo pipefail

if ! command -v cc >/dev/null || ! command -v pkg-config >/dev/null; then
  sudo apt-get update
  sudo apt-get install -y build-essential pkg-config
fi
if [ ! -x "$HOME/.cargo/bin/rustup" ]; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs |
    sh -s -- -y --profile minimal --default-toolchain none
fi
export PATH="$HOME/.cargo/bin:$PATH"
rustup toolchain install 1.98.1 --profile minimal --component rustfmt --component clippy
if ! grep -Fq '. "$HOME/.cargo/env"' "$HOME/.bash_profile" 2>/dev/null; then
  printf '\n[ ! -f "$HOME/.cargo/env" ] || . "$HOME/.cargo/env"\n' >> "$HOME/.bash_profile"
fi
if [ -f Cargo.lock ]; then
  cargo fetch --locked
fi
if [ -f experiments/api-slice/web/package-lock.json ]; then
  npm --prefix experiments/api-slice/web ci
fi
bash experiments/api-slice/checks/install-mailpit.sh
