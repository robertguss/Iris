{
  "components": {
    "schemas": {
      "AcceptRequest": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "description": "Opaque invitation credential. Identity is never accepted in this body.",
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "Acceptance": {
        "properties": {
          "project_id": {
            "description": "IDs are strings at the wire boundary to avoid JavaScript integer loss.",
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "user_id"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "invalid_request",
          "csrf",
          "login_failed",
          "forbidden",
          "recipient_not_found",
          "already_member",
          "invitation_pending",
          "unauthorized",
          "not_found",
          "expired",
          "already_accepted",
          "internal",
          "unavailable"
        ],
        "type": "string"
      },
      "IssueRequest": {
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "description": "Positive signed-64-bit decimal ID. No leading zeros.",
            "maxLength": 19,
            "pattern": "^[1-9][0-9]*$",
            "type": "string"
          },
          "recipient_id": {
            "description": "Existing account; same ID format as project_id.",
            "maxLength": 19,
            "pattern": "^[1-9][0-9]*$",
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "recipient_id"
        ],
        "type": "object"
      },
      "IssuedInvitation": {
        "properties": {
          "expires_at": {
            "description": "Unix seconds, serialized as a string.",
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "recipient_id": {
            "type": "string"
          },
          "token": {
            "description": "Demo-only delivery: treat as a credential. Stored only as a hash.",
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "recipient_id",
          "token",
          "expires_at"
        ],
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BrowserSession": {
        "description": "HTTPS browser session; unsafe requests also require Origin and X-Iris-Csrf.",
        "in": "cookie",
        "name": "__Host-iris-session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Iris invitation experiment",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/invitations": {
      "post": {
        "operationId": "issueInvitation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedInvitation"
                }
              }
            },
            "description": "Invitation issued; membership unchanged"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Sign-in required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not a project owner or CSRF validation failed"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Recipient not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Already a member or invitation pending"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Database busy"
          }
        },
        "security": [
          {
            "BrowserSession": []
          }
        ]
      }
    },
    "/api/invitations/accept": {
      "post": {
        "operationId": "acceptInvitation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Acceptance"
                }
              }
            },
            "description": "Invitation accepted; existing membership role preserved"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid JSON, fields, or token length"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Sign-in required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "CSRF validation failed"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown token or wrong recipient"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Expired or already accepted"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Database busy"
          }
        },
        "security": [
          {
            "BrowserSession": []
          }
        ]
      }
    }
  }
}
