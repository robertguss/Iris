{
  "components": {
    "schemas": {
      "AcceptRequest": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "description": "Opaque invitation credential. Identity is never accepted in this body.",
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "Acceptance": {
        "properties": {
          "project_id": {
            "description": "IDs are strings at the wire boundary to avoid JavaScript integer loss.",
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "user_id"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "invalid_request",
          "unauthorized",
          "not_found",
          "expired",
          "already_accepted",
          "internal",
          "unavailable"
        ],
        "type": "string"
      },
      "Problem": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "DevIdentity": {
        "description": "Synthetic identity; never deploy this as authentication.",
        "in": "header",
        "name": "x-iris-dev-user",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Iris invitation experiment",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/invitations/accept": {
      "post": {
        "operationId": "acceptInvitation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Acceptance"
                }
              }
            },
            "description": "Invitation accepted; existing membership role preserved"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid JSON, fields, or token length"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing or invalid development identity"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown token or wrong recipient"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Expired or already accepted"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Database busy"
          }
        },
        "security": [
          {
            "DevIdentity": []
          }
        ]
      }
    }
  }
}
