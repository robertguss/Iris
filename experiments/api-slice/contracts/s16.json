  "components": {
    "schemas": {
      "ChangeRoleRequest": {
        "type": "object",
        "required": [
          "project_id",
          "user_id",
          "role"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "maxLength": 19,
            "pattern": "^[1-9][0-9]*$"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "user_id": {
            "type": "string",
            "maxLength": 19,
            "pattern": "^[1-9][0-9]*$"
          }
        },
        "additionalProperties": false
      },
      "Completion": {
        "type": "string",
        "enum": [
          "acknowledged"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "owner",
          "editor",
          "viewer"
        ]
      },
      "SuccessData": {
        "type": "object",
        "required": [
          "completion"
        ],
        "properties": {
          "completion": {
            "$ref": "#/components/schemas/Completion"
          }
        }
      }
    },
    "securitySchemes": {
      "BrowserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-iris-session",
        "description": "Same-origin session and X-Iris-Csrf required. Explicit HTTP-loopback test mode uses iris-session-dev."
      }
