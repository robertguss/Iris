{
  "name": "iris-api-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "generate": "node scripts/contracts.mjs",
    "check:contracts": "node scripts/contracts.mjs --check",
    "check:breaking": "node scripts/breaking-change.mjs",
    "generate:s16": "node scripts/s16.mjs --generate",
    "verify:s16": "node scripts/s16.mjs",
    "probe:s16": "node scripts/s16-probes.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "verify": "npm run check:contracts && npm run build && npm run check:breaking"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
